DATABASE_URL="postgresql://usuario:senha@host/neondb?sslmode=require"
JWT_SECRET="segredo-forte"
JWT_EXPIRES_IN="7d"
PORT=3001
FRONTEND_URL="http://localhost:5173"

# Google Calendar OAuth — configure no Google Cloud e no Render.
# O callback deve ser exatamente: https://SEU_BACKEND.onrender.com/api/calendar/callback
GOOGLE_CLIENT_ID="seu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-client-secret"
GOOGLE_TOKEN_ENCRYPTION_KEY="gere-uma-chave-secreta-longa-e-estavel"
GOOGLE_REDIRECT_URI="https://SEU_BACKEND.onrender.com/api/calendar/callback"

# SMTP — e-mails de recuperação de senha, convites, agenda diária e confirmação de consultas.
# Se omitido, os e-mails são apenas logados no console (fallback de dev).
SMTP_HOST="smtp.seuprovedor.com"
SMTP_PORT=587
SMTP_USER="usuario@seuprovedor.com"
SMTP_PASS="senha-aplicacao"
SMTP_FROM="FarmaAtende <naoresponda@seu-dominio.com>"
