DATABASE_URL="postgresql://usuario:senha@host/neondb?sslmode=require"
JWT_SECRET="segredo-forte"
JWT_EXPIRES_IN="7d"
PORT=3001
FRONTEND_URL="http://localhost:5173"

# Google Calendar OAuth — configure no Google Cloud e no Render.
# O callback deve ser exatamente: https://SEU_BACKEND.onrender.com/api/calendar/callback
GOOGLE_CLIENT_ID="seu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-client-secret"
GOOGLE_TOKEN_ENCRYPTION_KEY="gere-uma-chave-secreta-longa-e-estavel"
GOOGLE_REDIRECT_URI="https://SEU_BACKEND.onrender.com/api/calendar/callback"

# Armazenamento privado de anexos clínicos (S3 ou compatível, como Cloudflare R2).
# Nunca use bucket público e nunca coloque estes valores no frontend.
S3_BUCKET="nome-do-bucket-privado"
S3_REGION="auto"
S3_ENDPOINT="https://SEU-ENDPOINT-S3"
S3_FORCE_PATH_STYLE="false"
S3_ACCESS_KEY_ID="sua-chave-de-acesso"
S3_SECRET_ACCESS_KEY="seu-segredo-de-acesso"
S3_SERVER_SIDE_ENCRYPTION="AES256"

# Mercado Pago — checkout avulso e webhooks.
MERCADO_PAGO_ACCESS_TOKEN="seu-access-token-de-teste-ou-producao"
MERCADO_PAGO_MODE="test"
MERCADO_PAGO_WEBHOOK_SECRET="segredo-de-assinatura-do-webhook"
MERCADO_PAGO_NOTIFICATION_URL="https://SEU_BACKEND.onrender.com/api/payments/mercado-pago/webhook"
BACKEND_PUBLIC_URL="https://SEU_BACKEND.onrender.com"

# SMTP — e-mails de recuperação de senha, convites, agenda diária e confirmação de consultas.
# Se omitido, os e-mails são apenas logados no console (fallback de dev).
SMTP_HOST="smtp.seuprovedor.com"
SMTP_PORT=587
SMTP_USER="usuario@seuprovedor.com"
SMTP_PASS="senha-aplicacao"
SMTP_FROM="FarmaAtende <naoresponda@seu-dominio.com>"
